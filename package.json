{
  "name": "bglife",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Bulgarian life simulator covering birth through age 131.",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "node scripts/build.mjs --serve",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "native:sync": "npm run build && cap sync"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@playwright/test": "1.58.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.1",
    "typescript": "5.9.3"
  }
}
